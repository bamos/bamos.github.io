<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">

<head>
  <meta charset="utf-8">
  <title>{{ page.title | escape_once }}</title>

  <meta name="author" content="{{ site.name | escape_once }}" />
  {% assign description = page.description %}
  {% if page.layout == 'index' %}
    {% comment %}Use the opening formal-bio paragraph without maintaining a separate description.{% endcomment %}
    {% assign bio_page = site.pages | where: 'path', 'bio.md' | first %}
    {% assign description = bio_page.content | markdownify | split: '</p>' | first | strip_html | normalize_whitespace %}
  {% endif %}
  {% if description and description != empty %}
  <meta name="description" content="{{ description | escape_once }}" />
  {% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if page.layout == 'index' %}
  <script src="/js/home-view.js"></script>
  {% endif %}

  <link rel="alternate" type="application/rss+xml" href="/atom.xml" />

  {% include site-styles.html %}
  {% if page.layout == 'index' %}
  <script type="module" src="/js/home-tabs.js"></script>
  <script type="module" src="/js/publication-abstracts.js"></script>
  {% endif %}
  <script src="/vendor/js/jquery.min.js"></script>

</head>

<body>
{% include site-header.html %}

{{ content }}

        <script src="/vendor/js/bootstrap.min.js"></script>
        <script src="/vendor/js/anchor.min.js"></script>
        <script src="/vendor/js/jquery.toc.js"></script>
        <script type="text/javascript">
          {% if page.layout == 'index' or page.path == 'bio.md' %}
          document.addEventListener('copy', event => {
              const bio = document.getElementById('bio');
              const selection = document.getSelection();
              if (!bio || !event.clipboardData || selection?.rangeCount !== 1 ||
                  selection.isCollapsed) return;

              const range = selection.getRangeAt(0);
              if (!bio.contains(range.commonAncestorContainer)) return;

              let text = selection.toString();
              const bioName = bio.querySelector('[data-formal-bio-url]');
              if (bioName && selection.containsNode(bioName.firstChild, false)) {
                  const name = bioName.textContent;
                  text = text.replace(name, name + ' (' + bioName.dataset.formalBioUrl + ')');
              }
              event.clipboardData.setData('text/plain', text);
              event.preventDefault();
          });
          {% endif %}

          (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
              (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
                                   m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
                                  })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');

          ga('create', 'UA-102191838-1', 'auto');
          ga('send', 'pageview');
  </script>
</body>
</html>
